# Backend WebSocket endpoint
VITE_WS_URL=ws://localhost:5762/ws
# VITE_WS_URL=ws://192.168.x.x:5762/ws # Use this for LAN connections

# ESP32 MJPEG stream endpoint
VITE_STREAM_URL=

# ESP32 stream control endpoint (used by FE Play/Pause button)
# For the Arduino IDE sample, both endpoints are on port 81.
VITE_ESP32_STREAM_CONTROL_URL=

# API key for authentication with the backend API
VITE_API_KEY=
