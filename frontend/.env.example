# Frontend env (Vite)
# Copy this file to .env and update values.

# Backend WebSocket endpoint
VITE_WS_URL=

# ESP32 MJPEG stream endpoint
VITE_STREAM_URL=

# ESP32 stream control endpoint (used by FE Play/Pause button)
VITE_ESP32_STREAM_CONTROL_URL=

# API key for backend calls from frontend (if needed)
VITE_API_KEY=
